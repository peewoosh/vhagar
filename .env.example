# Required — vhagar won't boot without these.
# URLs can be a bare host (https:// is added automatically) or a full URL.
RADARR_URL=radarr.example.com
RADARR_API_KEY=
SONARR_URL=sonarr.example.com
SONARR_API_KEY=
PROWLARR_URL=prowlarr.example.com
PROWLARR_API_KEY=
QBIT_URL=qbit.example.com
QBIT_USERNAME=
QBIT_PASSWORD=

# Optional — each feature just stays disabled/hidden if unset.
JELLYFIN_URL=
JELLYFIN_API_KEY=
BAZARR_URL=
BAZARR_API_KEY=

# Library paths — as mounted inside the backend container.
MOVIES_ROOT=/media/movies
SHOWS_ROOT=/media/tv

# Storage bar on the Library page — defaults to MOVIES_ROOT if unset.
STORAGE_PATH=/media

# Share links — feature only appears once SHARE_BASE_URL is set.
SHARE_BASE_URL=
SHARE_DATA_DIR=/app/data
SHARE_EXPIRY_DAYS=7
SHARE_PASSWORD=

# Radarr/Sonarr profile IDs to use when adding new items (default: 1).
ARR_QUALITY_PROFILE_ID=1
ARR_LANGUAGE_PROFILE_ID=1
